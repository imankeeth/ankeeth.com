{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ankeeth-dev",
  "compatibility_date": "2026-11-18",
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/notes",
      "/notes/*"
    ]
  },
  "main": "worker/index.mjs",
  "previews": {}
}
