---
import { render } from 'astro:content';
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import Site from '../../layouts/Site.astro';
import { formatDate, getNotes } from '../../lib/notes';

export const getStaticPaths = (async () =>
  (await getNotes()).map((note) => ({ params: { id: note.id }, props: { note } }))
) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { note } = Astro.props;
const { title, description, publishedOn } = note.data;
const { Content } = await render(note);
---
<Site {title} {description} {publishedOn}>
  <article class="reading-page note-page" aria-labelledby="page-title">
    <a href="/notes/"><span aria-hidden="true">←</span> All notes</a>
    <h1 id="page-title">{title}</h1>
    <p><time datetime={publishedOn}>{formatDate(publishedOn)}</time></p>
    <div class="note-prose"><Content /></div>
  </article>
</Site>
