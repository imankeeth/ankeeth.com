---
import Site from '../../layouts/Site.astro';
import NotesList from '../../components/NotesList.astro';
import { getNotes } from '../../lib/notes';

const notes = await getNotes();
---
<Site title="Notes" description="Short observations on building software and AI agents by Ankeeth Suvarna." notes>
  <section class="reading-page" aria-labelledby="page-title">
    <h1 id="page-title">Notes</h1>
    {notes.length > 0 && <p class="page-intro">Short observations on building software and AI agents.</p>}
    <NotesList items={notes} />
  </section>
</Site>
