---
import profile from '../assets/ankeeth-profile.webp';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
  notes?: boolean;
  noindex?: boolean;
  publishedOn?: string;
  imagePath?: string;
  imageAlt?: string;
}

const {
  title,
  description = 'Ankeeth Suvarna builds software systems and tools for AI agents.',
  home = false,
  notes = false,
  noindex = false,
  publishedOn,
  imagePath = '/social-card.png',
  imageAlt = 'Ankeeth Suvarna. Engineer. Builder. Always learning. Portrait and ankeeth.com.',
} = Astro.props;
const pageTitle = title ? (home ? title : `${title} | Ankeeth Suvarna`) : 'Ankeeth Suvarna';
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(imagePath, Astro.site);
const socialImageAlt = imageAlt;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex,follow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={publishedOn ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Ankeeth Suvarna" />
    {!noindex && <meta property="og:url" content={canonical} />}
    {publishedOn && <meta property="article:published_time" content={publishedOn} />}
    {!noindex && <>
      <meta property="og:image" content={socialImage} />
      <meta property="og:image:type" content="image/png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content={socialImageAlt} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={pageTitle} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={socialImage} />
      <meta name="twitter:image:alt" content={socialImageAlt} />
    </>}
    <meta name="theme-color" content="#eeecea" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="alternate" href="/rss.xml" type="application/rss+xml" title="Notes by Ankeeth Suvarna" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="layout">
      <header class="site-header">
        <a class="name" href="/" aria-current={home ? 'page' : undefined}>
          <img class="name-photo" src={profile.src} width="36" height="36" alt="" />
          Ankeeth Suvarna
        </a>
        <nav aria-label="Main navigation">
          <a href={home ? '#work' : '/#work'}>Work</a>
          <a href={home ? '#notes' : '/notes/'} aria-current={notes ? 'page' : undefined}>Notes</a>
          <a href={home ? '#contact' : '/#contact'}>Contact</a>
        </nav>
      </header>
      <main id="main" tabindex="-1"><slot /></main>
    </div>
  </body>
</html>
